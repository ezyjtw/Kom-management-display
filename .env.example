# Database (PostgreSQL — required for both local dev and production)
# Local: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kommand"
# Railway: auto-injected by Postgres plugin
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Authentication (NextAuth.js)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-in-production
# Set to your Railway public URL for production (e.g. https://your-app.up.railway.app)
NEXTAUTH_URL=http://localhost:3000

# Encryption-at-rest key for sensitive database fields (AES-256-GCM)
# Generate with: openssl rand -hex 32
# Must be at least 32 characters long
ENCRYPTION_SECRET=

# CSRF allowed origins (comma-separated, only needed if serving from multiple domains)
# CSRF_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com

# Jira Integration (fill in for production)
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=

# Confluence Integration
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_EMAIL=

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=
SLACK_CHANNELS=C01234ABCDE,C05678FGHIJ

# Email Integration (IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=ops-inbox@yourcompany.com
IMAP_PASSWORD=your-app-password
IMAP_TLS=true

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ops-inbox@yourcompany.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=ops@yourcompany.com
SMTP_SECURE=false

# Cron / background jobs secret (used to authenticate cron webhook calls)
CRON_SECRET=

# Seed endpoint control (set ALLOW_SEED=true to enable in production)
# ALLOW_SEED=false
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
# SEED_LEAD_PASSWORD=

# Fireblocks Integration
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_SECRET=

# Custody API Integration
CUSTODY_API_BASE_URL=
CUSTODY_API_USER=
CUSTODY_API_SECRET=

# Notabene Travel Rule Integration
# Base URL: https://api.notabene.id (production) or https://api.notabene.dev (sandbox)
NOTABENE_API_BASE_URL=https://api.notabene.id
NOTABENE_API_TOKEN=
NOTABENE_VASP_DID=did:ethr:0x...

# Notification channels
SLACK_OPS_CHANNEL=#ops-alerts
SLACK_COMPLIANCE_CHANNEL=#compliance-alerts
COMPLIANCE_EMAIL_RECIPIENTS=

# AI Provider (groq, anthropic, or ollama)
AI_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
