# Database (PostgreSQL — required for both local dev and production)
# Local: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kommand"
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Authentication (NextAuth.js)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-in-production
# Canonical URL of the web app
NEXTAUTH_URL=http://localhost:3000

# Single sign-on (Entra ID). The app registration must emit the `groups` claim
# (security group object IDs) in the ID token.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# JSON map of Entra group object ID -> role (admin | lead | employee | auditor),
# e.g. {"00000000-0000-0000-0000-000000000000":"lead"}. Users in no mapped group are denied.
ROLE_GROUP_MAP=
# Local username/password login. Ignored in production. Set to true for local dev.
ALLOW_LOCAL_LOGIN=

# Egress allowlist. The Komainu API host, the Atlassian site, api.atlassian.com,
# slack.com, graph.microsoft.com and login.microsoftonline.com are always allowed.
# Atlassian site URL (defaults to https://komainu.atlassian.net)
ATLASSIAN_BASE_URL=
# Extra comma-separated hostnames, e.g. for an optional module you have switched on
EGRESS_EXTRA_HOSTS=

# Build metadata shown by /api/health?deep=true
GIT_COMMIT_SHA=

# Encryption-at-rest key for sensitive database fields (AES-256-GCM)
# Generate with: openssl rand -hex 32
# Must be at least 32 characters long
ENCRYPTION_SECRET=

# CSRF allowed origins (comma-separated, only needed if serving from multiple domains)
# CSRF_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com

# Jira Integration (fill in for production)
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=

# Confluence Integration
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_EMAIL=

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=
SLACK_CHANNELS=C01234ABCDE,C05678FGHIJ

# Email Integration (IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=ops-inbox@yourcompany.com
IMAP_PASSWORD=your-app-password
IMAP_TLS=true

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ops-inbox@yourcompany.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=ops@yourcompany.com
SMTP_SECURE=false

# Cron / background jobs secret (used to authenticate cron webhook calls)
CRON_SECRET=

# Seeding: never runs in production; elsewhere only when ALLOW_SEED=true
# ALLOW_SEED=false
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
# SEED_LEAD_PASSWORD=

# Fireblocks Integration
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_SECRET=

# Custody API Integration
KOMAINU_API_BASE_URL=https://api-demo.komainu.io
KOMAINU_API_USER=
KOMAINU_API_SECRET=

# Notabene Travel Rule Integration — disabled (H11); also needs flag integration.notabene.enabled
NOTABENE_API_BASE_URL=
NOTABENE_API_TOKEN=
NOTABENE_VASP_DID=did:ethr:0x...

# Notification channels
SLACK_OPS_CHANNEL=#ops-alerts
SLACK_COMPLIANCE_CHANNEL=#compliance-alerts
COMPLIANCE_EMAIL_RECIPIENTS=

# AI Provider (none, groq, anthropic, or ollama) — defaults to none (H3)
AI_PROVIDER=none
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
