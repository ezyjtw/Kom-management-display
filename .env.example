# Secrets (spec §17.3). In production every secret-bearing key below
# (NEXTAUTH_SECRET, *_TOKEN, *_SECRET, *_PASSWORD, *_API_KEY) is read from a
# file of the same name in SECRETS_DIR (Key Vault mounted on tmpfs), never from
# an environment variable; startup fails if one is set. In development, leave
# SECRETS_DIR unset to read them from this file. See docs/phase1/credentials.md.
# SECRETS_DIR=/mnt/secrets

# Database (PostgreSQL — required for both local dev and production)
# Local: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kommand"
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Authentication (NextAuth.js)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-in-production
# Canonical URL of the web app
NEXTAUTH_URL=http://localhost:3000

# Single sign-on (Entra ID). The app registration must emit the `groups` claim
# (security group object IDs) in the ID token.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# JSON map of Entra group object ID -> role (admin | lead | employee | auditor),
# e.g. {"00000000-0000-0000-0000-000000000000":"lead"}. Users in no mapped group are denied.
ROLE_GROUP_MAP=
# Local username/password login. Ignored in production. Set to true for local dev.
ALLOW_LOCAL_LOGIN=

# Egress allowlist. The Komainu API host, the Atlassian site, api.atlassian.com,
# slack.com, graph.microsoft.com and login.microsoftonline.com are always allowed.
# Atlassian site URL (defaults to https://komainu.atlassian.net)
ATLASSIAN_BASE_URL=
# Extra comma-separated hostnames, e.g. for an optional module you have switched on
EGRESS_EXTRA_HOSTS=

# Build metadata shown by /api/health?deep=true
GIT_COMMIT_SHA=
# Which workload this process is (web | worker); recorded with credential use.
# `npm run worker` sets worker.
KOM_WORKLOAD=

# Encryption-at-rest key for sensitive database fields (AES-256-GCM)
# Generate with: openssl rand -hex 32
# Must be at least 32 characters long
ENCRYPTION_SECRET=

# CSRF allowed origins (comma-separated, only needed if serving from multiple domains)
# CSRF_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com

# Jira / JSM (spec §8.2): dedicated Atlassian service account.
# ATLASSIAN_BASE_URL is set in the egress section above.
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Confluence Integration
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_EMAIL=

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=
SLACK_CHANNELS=C01234ABCDE,C05678FGHIJ

# Microsoft Graph (spec §8.5): mail and Teams, read-only application permissions.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# JSON [{"label":"custody","address":"...","purpose":"custody|fab_ics|vendor_notifications"}] (CONFIRM-MAILBOXES)
GRAPH_MAILBOXES=
# JSON [{"label":"ops","teamId":"...","channelId":"..."}]
GRAPH_TEAMS_CHANNELS=

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ops-inbox@yourcompany.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=ops@yourcompany.com
SMTP_SECURE=false

# Cron / background jobs secret (used to authenticate cron webhook calls)
CRON_SECRET=

# Seeding: never runs in production; elsewhere only when ALLOW_SEED=true
# ALLOW_SEED=false
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
# SEED_LEAD_PASSWORD=

# Fireblocks Integration
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_SECRET=

# Custody API Integration
KOMAINU_API_BASE_URL=https://api-demo.komainu.io
KOMAINU_API_USER=
KOMAINU_API_SECRET=
# Several read-only API users (CONFIRM-API-SCOPE): JSON [{"label","user","secretRef"}],
# where secretRef names an env var KOMAINU_API_SECRET_<SUFFIX> holding that user's secret.
KOMAINU_API_CREDENTIALS=

# Notabene Travel Rule Integration — disabled (H11); also needs flag integration.notabene.enabled
NOTABENE_API_BASE_URL=
NOTABENE_API_TOKEN=
NOTABENE_VASP_DID=did:ethr:0x...

# Notification channels
SLACK_OPS_CHANNEL=#ops-alerts
SLACK_COMPLIANCE_CHANNEL=#compliance-alerts
COMPLIANCE_EMAIL_RECIPIENTS=

# AI Provider (none, groq, anthropic, or ollama) — defaults to none (H3)
AI_PROVIDER=none
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
